# Aggregating over two datasets needs each aggregate computed at its own grain.
statement error
SELECT ossie_compile(['store_productivity'], ['store.s_state'], []);
----
aggregate over 2 datasets

statement error
SELECT ossie_compile(['total_sales'], [], ['date_dim.d_year = 2001']);
----
filters are not supported yet

statement error
SELECT ossie_compile([], [], []);
----
at least one metric is required

# Two routes to the same dataset are refused rather than picked.
statement ok
CALL ossie_load('test/fixtures/ambiguous_path_model.json');

statement error
