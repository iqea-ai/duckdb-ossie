# name: test/sql/ossie_compile.test
# description: golden SQL for compiled semantic requests
# group: [sql]

require ossie

statement error
SELECT ossie_compile(['total_sales'], [], []);
----
no Ossie model is loaded

statement ok
CALL ossie_load('test/fixtures/tpcds_semantic_model.json', rebind => MAP{'tpcds.public': 'tpcds.main'});

query T
SELECT ossie_compile(['total_sales'], [], []);
----
SELECT sum(store_sales.ss_ext_sales_price) AS total_sales FROM tpcds.main.store_sales AS store_sales

query T
SELECT ossie_compile(['total_sales', 'total_profit'], [], []);
----
SELECT sum(store_sales.ss_ext_sales_price) AS total_sales, sum(store_sales.ss_net_profit) AS total_profit FROM tpcds.main.store_sales AS store_sales

# A dimension pulls in its dataset over the declared relationship and adds a GROUP BY.
query T
SELECT ossie_compile(['total_sales'], ['item.i_brand'], []);
----
SELECT item.i_brand AS "item.i_brand", sum(store_sales.ss_ext_sales_price) AS total_sales FROM tpcds.main.store_sales AS store_sales INNER JOIN tpcds.main.item AS item ON ((store_sales.ss_item_sk = item.i_item_sk)) GROUP BY item.i_brand

# Join order follows the order the dimensions were requested, and is deliberately deterministic:
# the set of required datasets used to be a case_insensitive_set_t, whose iteration order is
# implementation-defined, so this SQL differed between MSVC and libc++. Reversing the request
# below must reverse the joins -- that is what proves the order is chosen rather than incidental.
query T
SELECT ossie_compile(['total_sales'], ['item.i_brand', 'store.s_state'], []);
----
SELECT item.i_brand AS "item.i_brand", store.s_state AS "store.s_state", sum(store_sales.ss_ext_sales_price) AS total_sales FROM tpcds.main.store_sales AS store_sales INNER JOIN tpcds.main.item AS item ON ((store_sales.ss_item_sk = item.i_item_sk)) INNER JOIN tpcds.main.store AS store ON ((store_sales.ss_store_sk = store.s_store_sk)) GROUP BY item.i_brand, store.s_state

query T
SELECT ossie_compile(['total_sales'], ['store.s_state', 'item.i_brand'], []);
----
SELECT store.s_state AS "store.s_state", item.i_brand AS "item.i_brand", sum(store_sales.ss_ext_sales_price) AS total_sales FROM tpcds.main.store_sales AS store_sales INNER JOIN tpcds.main.store AS store ON ((store_sales.ss_store_sk = store.s_store_sk)) INNER JOIN tpcds.main.item AS item ON ((store_sales.ss_item_sk = item.i_item_sk)) GROUP BY store.s_state, item.i_brand

# A computed dimension is inlined into both the projection and the GROUP BY, since
# customer_full_name does not exist as a column on the table.
query T
SELECT ossie_compile(['total_sales'], ['customer.customer_full_name'], []);
----
SELECT ((customer.c_first_name || ' ') || customer.c_last_name) AS "customer.customer_full_name", sum(store_sales.ss_ext_sales_price) AS total_sales FROM tpcds.main.store_sales AS store_sales INNER JOIN tpcds.main.customer AS customer ON ((store_sales.ss_customer_sk = customer.c_customer_sk)) GROUP BY ((customer.c_first_name || ' ') || customer.c_last_name)

statement error
SELECT ossie_compile(['total_sale'], [], []);
----
Did you mean: "total_sales"

statement error
SELECT ossie_compile(['total_sales'], ['item.i_brnad'], []);
----
Did you mean: "item.i_brand"

statement error
SELECT ossie_compile(['total_sales'], ['i_brand'], []);
----
must be qualified as dataset.field

statement error
SELECT ossie_compile(['total_sales'], ['nosuch.field'], []);
----
names dataset "nosuch", which the model does not declare

# Aggregating at two grains needs one aggregate per grain. See ossie_grain.test.
statement error
SELECT ossie_compile(['store_productivity'], ['store.s_state'], []);
----
aggregate at 2 different grains

statement error
SELECT ossie_compile([], [], []);
----
at least one metric is required

# A filter pulls in the join it needs, even when no dimension uses that dataset. Dimensions are
# joined before filter-only datasets, so item precedes date_dim here.
query T
SELECT ossie_compile(['total_sales'], ['item.i_brand'], ['date_dim.d_year = 2001']);
----
SELECT item.i_brand AS "item.i_brand", sum(store_sales.ss_ext_sales_price) AS total_sales FROM tpcds.main.store_sales AS store_sales INNER JOIN tpcds.main.item AS item ON ((store_sales.ss_item_sk = item.i_item_sk)) INNER JOIN tpcds.main.date_dim AS date_dim ON ((store_sales.ss_sold_date_sk = date_dim.d_date_sk)) WHERE (date_dim.d_year = 2001) GROUP BY item.i_brand

# A filter naming a metric is an aggregate, so it becomes HAVING rather than WHERE.
query T
SELECT ossie_compile(['total_sales'], ['item.i_brand'], ['total_sales > 1000']);
----
SELECT item.i_brand AS "item.i_brand", sum(store_sales.ss_ext_sales_price) AS total_sales FROM tpcds.main.store_sales AS store_sales INNER JOIN tpcds.main.item AS item ON ((store_sales.ss_item_sk = item.i_item_sk)) GROUP BY item.i_brand HAVING (sum(store_sales.ss_ext_sales_price) > 1000)

# Operators are always permitted: LIKE, IN and arithmetic all desugar to operator functions.
query T
SELECT ossie_compile(['total_sales'], [], ['item.i_brand LIKE ''A%''']);
----
SELECT sum(store_sales.ss_ext_sales_price) AS total_sales FROM tpcds.main.store_sales AS store_sales INNER JOIN tpcds.main.item AS item ON ((store_sales.ss_item_sk = item.i_item_sk)) WHERE (item.i_brand ~~ 'A%')

query T
SELECT ossie_compile(['total_sales'], [], ['store.s_state IN (''CA'', ''NY'')']);
----
SELECT sum(store_sales.ss_ext_sales_price) AS total_sales FROM tpcds.main.store_sales AS store_sales INNER JOIN tpcds.main.store AS store ON ((store_sales.ss_store_sk = store.s_store_sk)) WHERE (store.s_state IN ('CA', 'NY'))

# Named function calls are refused unless the model was loaded permitting them.
statement error
SELECT ossie_compile(['total_sales'], [], ['upper(item.i_brand) = ''ACME''']);
----
calls function "upper"

statement error
SELECT ossie_compile(['total_sales'], [], ['EXISTS (SELECT 1 FROM secret)']);
----
contains a subquery

statement error
SELECT ossie_compile(['total_sales'], [], ['d_year = 2001']);
----
neither a metric nor a dataset.field name

statement ok
CALL ossie_load('test/fixtures/tpcds_semantic_model.json', rebind => MAP{'tpcds.public': 'tpcds.main'}, allow_filter_functions => true);

query T
SELECT ossie_compile(['total_sales'], [], ['upper(item.i_brand) = ''ACME''']);
----
SELECT sum(store_sales.ss_ext_sales_price) AS total_sales FROM tpcds.main.store_sales AS store_sales INNER JOIN tpcds.main.item AS item ON ((store_sales.ss_item_sk = item.i_item_sk)) WHERE (upper(item.i_brand) = 'ACME')

# The flag permits function calls, never reaching tables outside the model.
statement error
SELECT ossie_compile(['total_sales'], [], ['EXISTS (SELECT 1 FROM secret)']);
----
contains a subquery

# Two routes to the same dataset are refused rather than picked.
statement ok
CALL ossie_load('test/fixtures/ambiguous_path_model.json');

statement error
SELECT ossie_compile(['total_sales'], ['item.i_brand', 'store.s_state'], []);
----
more than one join path connects