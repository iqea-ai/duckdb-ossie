# name: test/sql/ossie_load.test
# description: ossie_load parses the reference TPC-DS model and refuses bad ones
# group: [sql]

require ossie

# The reference model: 5 datasets, 31 fields, 4 relationships, 5 metrics.
query TTIIII
CALL ossie_load('test/fixtures/tpcds_semantic_model.json');
----
tpcds_retail_model	0.2.0.dev0	5	31	4	5

# rebind remaps the warehouse prefix onto the local catalog; counts are unaffected.
query TTIIII
CALL ossie_load('test/fixtures/tpcds_semantic_model.json', rebind => MAP{'tpcds.public': 'tpcds.main'});
----
tpcds_retail_model	0.2.0.dev0	5	31	4	5

statement error
CALL ossie_load('/does/not/exist.json');
----
IO Error

# validate_sources is off by default, so a model loads with no local tables at all.
statement ok
CREATE TABLE store_sales(a INT);

statement ok
CREATE TABLE date_dim(a INT);

statement ok
CREATE TABLE item(a INT);

# Every unresolved source is reported at once rather than one per attempt.
statement error
CALL ossie_load('test/fixtures/tpcds_semantic_model.json', rebind => MAP{'tpcds.public': 'memory.main'}, validate_sources => true);
----
2 of 5 dataset sources do not exist in the catalog

statement ok
CREATE TABLE customer(a INT);

statement ok
CREATE TABLE store(a INT);

query TTIIII
CALL ossie_load('test/fixtures/tpcds_semantic_model.json', rebind => MAP{'tpcds.public': 'memory.main'}, validate_sources => true);
----
tpcds_retail_model	0.2.0.dev0	5	31	4	5

# The model is held per database, not per connection: an MCP server answers on its own connection
# and must see a model loaded by the init script.
statement ok con1
CALL ossie_load('test/fixtures/tpcds_semantic_model.json', rebind => MAP{'tpcds.public': 'tpcds.main'});

query I con2
SELECT count(*) FROM ossie_metrics();
----
5
